<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <!--
    Ryzen Curve Optimizer - Polkit Action File
    ══════════════════════════════════════════════════════════════════
    One action, pinned to one root helper by exec.path. The exec.path below must be the
    EXACT path of the installed helper, and the applet must invoke that path directly:

        pkexec /usr/lib/ryzen-curve-optimizer/ryzen-curve-optimizer-helper

    NOT `pkexec some-interpreter .../helper`. polkit selects the action by matching the
    program pkexec is asked to run against exec.path, so passing an interpreter as the
    program makes this action unmatchable and silently falls back to polkit's generic
    exec action.

    The helper must also be root-owned and mode 0755 — pkexec refuses to run a program
    that is writable by group or other.

    Who may apply without a password is decided by the security level chosen at install
    time, in /etc/polkit-1/rules.d/49-ryzen-curve-optimizer.rules. The defaults below are the
    safe fallback when that file is absent: nobody gets a silent grant, an administrator
    at the machine authenticates once and polkit keeps it for its cache window.

    install.sh handles all of this, and rewrites the path below if you install with a
    non-default PREFIX.
  -->

  <action id="com.ryzencurveoptimizer.set-curve">
    <description>Apply Ryzen Curve Optimizer offsets via the Ryzen Curve Optimizer applet</description>
    <description xml:lang="tr">Ryzen Curve Optimizer uygulaması üzerinden Curve Optimizer ofsetlerini uygula</description>
    <message>Authentication is required to change the CPU Curve Optimizer voltage offsets</message>
    <message xml:lang="tr">CPU Curve Optimizer voltaj offsetlerini değiştirmek için kimlik doğrulama gerekiyor</message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ryzen-curve-optimizer/ryzen-curve-optimizer-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
